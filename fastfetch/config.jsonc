{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "source": "/home/max/.config/fastfetch/cachyOS.png",
    //"color": {
    //  "1": "white",
    //  "2": "red",
    //  "3": "38;2;50;50;50",
    //  "4": "green"
    //}
    "width": 35,
    "padding": {
      "top": 1,
      "right": 1,
      "left": 1
    }
  },
  "display": { "separator": " " },
  "modules": [
    { "key": "╭───────────╮", "type": "custom" },
    { "key": "│  user    │", "type": "title", "format": "{user-name}" },
    //{ "key": "│ 󰇅 hname   │", "type": "title", "format": "{host-name}" },
    { "key": "│ 󰅐 uptime  │", "type": "uptime" },
    {
      "key": "│ └  dtime │",
      "type": "command",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
    },
    { "key": "│  distro  │", "type": "os" },
    { "key": "│  kernel  │", "type": "kernel" },
    { "key": "│  WM      │", "type": "wm", "format": "{1} v{5}" },
    { "key": "│  term    │", "type": "terminal" },
    { "key": "│  shell   │", "type": "shell" },
    { "key": "├───────────┤", "type": "custom" },
    { "key": "│ PC        │", "type": "custom" },
    {
      "key": "│ ├ 󰍛 CPU   │",
      "type": "cpu",
      "format": "{1}",
      "showPeCoreCount": false
    },
    {
      "key": "│ ├ 󰢮 GPU   │",
      "type": "gpu",
      "hideType": "integrated",
      "format": "{1} {2}"
    },
    { "key": "│ ├  disk  │", "type": "disk", "folders": "/" },
    { "key": "│ ├  RAM   │", "type": "memory" },
    { "key": "│ └ 󰓡 swap  │", "type": "swap" },
    //{
    //  "key": "│ ├  disp  │",
    //  "type": "monitor",
    //  "format": "{2}×{3} @ {11}Hz"
    //},
    { "key": "╰───────────╯", "type": "custom" }
  ]
}
