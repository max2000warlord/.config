{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "source": "/home/max/.config/fastfetch/cachyos.png",
    "width": 35,
    "padding": {
      "top": 1,
      "right": 0,
      "left": 0
    }
    //"height": 10
  },
  "display": {
    "separator": "  "
  },
  "modules": [
    {
      "type": "custom", // SoftwareStart
      "format": "\u001b[38;2;23;147;209m╔════════════════════╗\u001b[0m"
    },
    {
      "type": "custom", // SoftwareStart
      "format": "\u001b[38;2;23;147;209m\u001b[38;2;23;147;209m║\u001b[1;34mHardware Information\u001b[38;2;23;147;209m║\u001b[0m"
    },
    {
      "type": "custom", // SoftwareStart
      "format": "\u001b[38;2;23;147;209m╚════════════════════╝\u001b[0m"
    },
    {
      "type": "cpu",
      "key": "\u001b[38;2;255;0;0m󰻠\u001b[0m",
      "format": "{1}"
    },
    {
      "type": "gpu",
      "hideType": "integrated",
      "key": "\u001b[1;32m󰢮\u001b[0m"
      //"format": ""
    },
    {
      "type": "disk",
      "key": "\u001b[38;2;255;165;0m\u001b[0m"
    },
    {
      "type": "memory",
      "key": "\u001b[1;33m\u001b[0m",
      "percent": {
        "type": 3, // 3 = show number + bar + percentage
        "green": 30, // <30% is green
        "yellow": 70 // 30-70% is yellow, >70% is red
      }
      //"format": "{1} / {2} ({3}) {4}"
    },
    {
      "type": "display",
      "key": "󰍹"
    },
    {
      "type": "custom", // SoftwareStart
      "format": "\u001b[38;2;23;147;209m╔════════════════════╗\u001b[0m"
    },
    {
      "type": "custom", // SoftwareStart
      "format": "\u001b[38;2;23;147;209m\u001b[38;2;23;147;209m║\u001b[1;34mSoftware Information\u001b[38;2;23;147;209m║\u001b[0m"
    },
    {
      "type": "custom", // SoftwareStart
      "format": "\u001b[38;2;23;147;209m╚════════════════════╝\u001b[0m"
    },
    {
      "type": "title",
      "key": "",
      "format": "{1}@{2}"
    },
    //{
    //  "type": "os",
    //  "key": "\u001b[38;2;23;147;209m󰣇\u001b[0m" // Just get your distro's logo off nerdfonts.com
    //},
    {
      "type": "kernel",
      "key": "\u001b[38;2;23;147;209m\u001b[0m",
      "format": "{2}"
    },
    {
      "type": "wm",
      "key": "",
      "format": "{2}"
    },
    {
      "type": "shell",
      "key": ""
    },
    {
      "type": "terminal",
      "key": "",
      "format": "{5}"
    },
    {
      "type": "packages",
      "key": "\u001b[38;2;255;255;0m󰮯\u001b[0m",
      "format": "{1}"
    },
    {
      "type": "uptime",
      "key": "󰅐"
    },
    {
      "type": "locale",
      "key": ""
    }
  ]
}
