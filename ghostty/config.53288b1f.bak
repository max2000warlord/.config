theme = Synthwave
font-family = "Hack Nerd Font"
font-size = 12
cursor-color = "#AAAAAA"
cursor-style = bar
cursor-style-blink = true
gtk-titlebar = false
confirm-close-surface = false
background-opacity = 0.5
desktop-notifications = false
keybind = alt+shift+right=new_split:right
keybind = alt+shift+down=new_split:down
window-padding-x = 0
window-padding-y = 0
